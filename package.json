{
  "name": "chorapp",
  "version": "1.2.0",
  "description": "ChorApp — app de estudio para el coro Bihotsak (regalo para Maite)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "sync": "npm run build && npx cap sync && node scripts/android-fix.js",
    "android": "npm run build && npx cap sync android && node scripts/android-fix.js && npx cap open android",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "coro",
    "bihotsak",
    "capacitor",
    "pwa"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/status-bar": "^7.0.6",
    "@jofr/capacitor-media-session": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
